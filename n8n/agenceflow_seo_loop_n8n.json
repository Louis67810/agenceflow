          "position": [320, 200]
        },
        {
          "parameters": {
            "jsCode": "const opps = $json[0]?.opportunities;\nif (!opps || !opps.new_articles) return [];\nconst top3 = opps.new_articles.sort((a, b) => (b.priority_score || 0) - (a.priority_score || 0)).slice(0, 3);\nreturn top3.map(article => ({ json: article }));"
          },
          "id": "wf4-pick-top",
          "name": "Sélectionner top 3 articles",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
