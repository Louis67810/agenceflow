          "id": "wf3-get-last-analysis",
          "name": "Récupérer dernière analyse",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [320, 200]
        },
        {
          "parameters": {
            "method": "GET",
            "url": "={{$env.AGENCEFLOW_BASE_URL}}/api/articles",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "x-api-key", "value": "={{$env.ARTICLE_AGENT_API_KEY}}" }
              ]
            }
          },
          "id": "wf3-get-articles",
          "name": "Articles existants",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [320, 360]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "https://openrouter.ai/api/v1/chat/completions",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "Authorization", "value": "=Bearer {{$env.OPENROUTER_API_KEY}}" },
                { "name": "Content-Type", "value": "application/json" },
                { "name": "HTTP-Referer", "value": "={{$env.AGENCEFLOW_BASE_URL}}" },
                { "name": "X-Title", "value": "AgenceFlow SEO Loop" }
              ]
            },
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={\n  \"model\": \"deepseek/deepseek-r1\",\n  \"max_tokens\": 4096,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es un stratège SEO senior. Ton rôle est d'identifier des opportunités de contenu à fort potentiel. Réponds UNIQUEMENT en JSON valide, sans markdown.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Voici l'analyse de performance des articles existants et la liste des articles actuels.\\n\\nANALYSE : \" + JSON.stringify({{ $('Récupérer dernière analyse').item.json[0]?.analysis || {} }}) + \"\\n\\nARTICLES EXISTANTS (slugs) : \" + JSON.stringify({{ $('Articles existants').all().map(i => i.json.slug || i.json.title) }}) + \"\\n\\nIdentifie :\\n1. Les mots-clés manqués (opportunités non couverts par les articles existants)\\n2. Les articles à optimiser en priorité (quick wins)\\n3. Les 5 nouveaux sujets d'articles à créer, priorisés par potentiel SEO\\n\\nRéponds avec : { \\\"missing_keywords\\\": [{\\\"keyword\\\": string, \\\"volume_estimate\\\": string, \\\"intent\\\": string, \\\"difficulty\\\": string}], \\\"quick_wins\\\": [{\\\"slug\\\": string, \\\"action\\\": string, \\\"expected_impact\\\": string}], \\\"new_articles\\\": [{\\\"title\\\": string, \\\"slug_suggestion\\\": string, \\\"target_keyword\\\": string, \\\"search_intent\\\": string, \\\"priority_score\\\": number, \\\"rationale\\\": string}], \\\"reasoning\\\": string }\"\n    }\n  ]\n}"
          },
          "id": "wf3-ai-opps",
          "name": "DeepSeek · Opportunités",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [620, 280]
        },
        {
          "parameters": {
            "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\nlet opps;\ntry {\n  opps = JSON.parse(raw);\n} catch(e) {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  opps = match ? JSON.parse(match[0]) : { error: 'parse_failed', raw };\n}\nconst cycleId = $('Webhook · Opportunités').item.json.body?.cycleId || $('Webhook · Opportunités').item.json.cycleId;\nreturn [{ json: { opportunities: opps, cycleId, generatedAt: new Date().toISOString() } }];"
          },
          "id": "wf3-parse",
          "name": "Parser opportunités",
          "type": "n8n-nodes-base.code",
          "typeVersion": 2,
          "position": [860, 280]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "={{$env.SUPABASE_URL}}/rest/v1/seo_opportunities",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "apikey", "value": "={{$env.SUPABASE_SERVICE_KEY}}" },
                { "name": "Authorization", "value": "=Bearer {{$env.SUPABASE_SERVICE_KEY}}" },
                { "name": "Content-Type", "value": "application/json" },
                { "name": "Prefer", "value": "return=minimal" }
              ]
            },
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={ \"cycle_id\": \"{{ $json.cycleId }}\", \"opportunities\": {{ JSON.stringify($json.opportunities) }}, \"generated_at\": \"{{ $json.generatedAt }}\", \"model_used\": \"deepseek/deepseek-r1\" }"
          },
          "id": "wf3-save",
          "name": "Sauvegarder Supabase",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1080, 280]
        },
        {
          "parameters": {
            "method": "POST",
            "url": "={{$env.AGENCEFLOW_BASE_URL}}/api/recommendations",
            "sendHeaders": true,
            "headerParameters": {
              "parameters": [
                { "name": "x-api-key", "value": "={{$env.ARTICLE_AGENT_API_KEY}}" },
                { "name": "Content-Type", "value": "application/json" }
              ]
            },
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={ \"cycle_id\": \"{{ $('Parser opportunités').item.json.cycleId }}\", \"recommendations\": {{ JSON.stringify($('Parser opportunités').item.json.opportunities) }} }"
          },
          "id": "wf3-push",
          "name": "Pousser vers AgenceFlow",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [1300, 280]
        },
        {
          "parameters": {
            "respondWith": "json",
            "responseBody": "={ \"status\": \"ok\", \"cycleId\": \"{{ $('Parser opportunités').item.json.cycleId }}\" }"
          },
          "id": "wf3-respond",
          "name": "Réponse webhook",
          "type": "n8n-nodes-base.respondToWebhook",
          "typeVersion": 1,
          "position": [1520, 280]
        }
      ],
      "connections": {
        "Webhook · Opportunités": {
          "main": [[
            { "node": "Récupérer dernière analyse", "type": "main", "index": 0 },
            { "node": "Articles existants", "type": "main", "index": 0 }
          ]]
        },
