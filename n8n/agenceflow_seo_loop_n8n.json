                { "name": "X-Title", "value": "AgenceFlow SEO Loop" }
              ]
            },
            "sendBody": true,
            "specifyBody": "json",
            "jsonBody": "={\n  \"model\": \"deepseek/deepseek-r1\",\n  \"max_tokens\": 6000,\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"Tu es un rédacteur SEO expert. Tu génères des briefs d'articles complets et structurés. Réponds UNIQUEMENT en JSON valide.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Génère un brief SEO complet pour cet article : \" + JSON.stringify({{ $json }}) + \"\\n\\nLe brief doit inclure :\\n- Un titre SEO optimisé (H1)\\n- La méta-description (150-160 chars)\\n- Le mot-clé principal et 5 mots-clés secondaires\\n- L'intention de recherche détaillée\\n- Le plan de l'article (H2/H3 avec description de chaque section)\\n- 3 angles différenciants vs la concurrence\\n- Les CTAs recommandés\\n- Les liens internes suggérés\\n- Un brouillon de l'introduction (200 mots)\\n- Estimation longueur cible (mots)\\n\\nRéponds avec : { \\\"h1\\\": string, \\\"meta_description\\\": string, \\\"primary_keyword\\\": string, \\\"secondary_keywords\\\": [string], \\\"search_intent\\\": string, \\\"plan\\\": [{\\\"h2\\\": string, \\\"h3s\\\": [string], \\\"description\\\": string}], \\\"differentiators\\\": [string], \\\"ctas\\\": [string], \\\"internal_links\\\": [string], \\\"introduction_draft\\\": string, \\\"target_word_count\\\": number, \\\"reasoning\\\": string }\"\n    }\n  ]\n}"
          },
          "id": "wf4-ai-brief",
          "name": "DeepSeek · Générer brief",
          "type": "n8n-nodes-base.httpRequest",
          "typeVersion": 4.2,
          "position": [960, 200]
        },
        {
          "parameters": {
            "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\nlet brief;\ntry {\n  brief = JSON.parse(raw);\n} catch(e) {\n  const match = raw.match(/\\{[\\s\\S]*\\}/);\n  brief = match ? JSON.parse(match[0]) : { error: 'parse_failed', raw };\n}\n\nconst cycleId = $('Webhook · Génération').item.json.body?.cycleId || $('Webhook · Génération').item.json.cycleId;\nconst articleMeta = $('Sélectionner top 3 articles').item.json;\n\nreturn [{ json: {\n  brief,\n  cycleId,\n  articleMeta,\n  generatedAt: new Date().toISOString(),\n  status: 'draft'\n} }];"
          },
          "id": "wf4-parse-brief",
          "name": "Parser brief",
