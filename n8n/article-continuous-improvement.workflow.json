            {
              "name": "Authorization",
              "value": "=Bearer {{$env.ARTICLE_AGENT_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{$json}}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "4198b92d-2f56-482d-b204-b588f6911dff",
      "name": "Save cycle in AgenceFlow",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
