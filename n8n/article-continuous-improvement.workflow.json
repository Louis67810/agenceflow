      "id": "f14a8b90-2577-41a8-9388-6d2c08a073c6",
      "name": "Get article context",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -640,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://openrouter.ai/api/v1/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{$env.OPENROUTER_API_KEY}}"
            },
            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ {\n  model: $json.settings?.agentAnalysisModel || 'openai/gpt-4.1',\n  messages: [\n    {\n      role: 'system',\n      content: 'Tu es le moteur d amelioration continue SEO d AgenceFlow. Tu dois analyser les pages ressources, expliquer tes decisions et retourner uniquement du JSON valide.'\n    },\n    {\n      role: 'user',\n      content: JSON.stringify({\n        objective: 'Analyser les performances des pages ressources et proposer le prochain cycle.',\n        required_output: {\n          summary: 'string',\n          winning_patterns: ['string'],\n          weak_pages: ['string'],\n          recommendations: [\n            {\n              title: 'string',\n              slug: 'string',\n              intent: 'informational|commercial|transactional',\n              priority: 1,\n              reason: 'string',\n              source_pages: ['string']\n            }\n          ],\n          actions: [\n            {\n              type: 'create_page|improve_page|research_more|pause_topic',\n              label: 'string',\n              reason: 'string'\n            }\n          ]\n        },\n        context: $json\n      })\n    }\n  ],\n  response_format: { type: 'json_object' }\n} }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "370d7caa-3658-454a-8215-16d33a66f53d",
      "name": "Analyse with AI",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        -380,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.choices?.[0]?.message?.content || '{}';\nlet analysis;\ntry {\n  analysis = JSON.parse(raw);\n} catch (error) {\n  analysis = {\n    summary: 'JSON parse failed',\n    winning_patterns: [],\n    weak_pages: [],\n    recommendations: [],\n    actions: [{ type: 'research_more', label: 'Verifier la sortie IA', reason: raw.slice(0, 1000) }]\n  };\n}\nreturn [{ json: { analysis, generatedAt: new Date().toISOString() } }];"
      },
      "id": "595e3071-464e-4602-bdcf-9c5615f6c913",
      "name": "Parse AI analysis",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -120,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{$env.AGENCEFLOW_BASE_URL}}/api/articles/agent/cycles",
        "sendHeaders": true,
        "headerParameters": {
