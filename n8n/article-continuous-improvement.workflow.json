        "sendBody": true,
        "bodyContentType": "json",
        "jsonBody": "={{ { cycleId: $json.cycle?.id || $json.id, recommendations: $json.analysis?.recommendations || [], actions: $json.analysis?.actions || [] } }}",
        "options": {
          "response": {
            "response": {
              "responseFormat": "json"
            }
          }
        }
      },
      "id": "9fdf4e99-f407-4bbf-8386-017a515756c6",
